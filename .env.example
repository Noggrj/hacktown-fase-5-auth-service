PORT=8080
APP_ENV=development
SERVICE_NAME=fiapx-auth-service

# postgres://user:password@host:5432/dbname?sslmode=disable
DB_URL=postgres://auth:auth@localhost:5433/fiapx_auth?sslmode=disable

# Shared HS256 secret — MUST match every other fiapx-* service's JWT_SECRET.
JWT_SECRET=change-me-to-a-random-32-byte-value
